// UniLuanda Profiles — ER model for https://dbdiagram.io
// Teaching history is unlimited. An assignment identifies one discipline and one academic year;
// semesters are children so the same teacher can teach that discipline in semester 1, semester 2,
// or both. The unique discipline/year pair prevents a second teacher from claiming it that year.
// A teacher may self-associate with a discipline in another course or organizational unit.

Enum user_role {
  USER
  UNIT_ADMIN
  SUPER_ADMIN
}

Enum main_function {
  DOCENTE
  INVESTIGADOR
  FUNCIONARIO_ADMINISTRATIVO
}

Enum profile_category {
  ASSISTENTE_ESTAGIARIO
  ASSISTENTE
  PROFESSOR_AUXILIAR
  PROFESSOR_ASSOCIADO
  PROFESSOR_CATEDRATICO
  ESTAGIARIO_INVESTIGACAO
  ASSISTENTE_INVESTIGACAO
  INVESTIGADOR_AUXILIAR
  INVESTIGADOR_PRINCIPAL
  TECNICO_SUPERIOR
  TECNICO_MEDIO
  TECNICO_BASE
}

Enum profile_position {
  DIRECTOR
  DIRECTOR_ADJUNTO
  CHEFE_DEPARTAMENTO
  CHEFE_SECCAO
  CHEFE_CENTRO
  DOCENTE
  TECNICO
}

Enum publication_status {
  DRAFT
  PUBLISHED
  INACTIVE
}

Enum degree_level {
  LICENCIATURA
  MESTRADO
  DOUTORAMENTO
}

Enum publication_type {
  BOOK
  ARTICLE
  OTHER
}

Enum academic_year_status {
  OPEN
  CLOSED
}

Table organizational_units {
  id bigint [pk, increment]
  name varchar(200) [not null, unique]
  code varchar(40) [not null, unique]
  description text
  is_active boolean [not null, default: true]
  created_at datetime [not null]
  updated_at datetime [not null]
}

Table users {
  id bigint [pk, increment]
  email varchar(320) [not null, unique]
  password_hash varchar(255) [not null]
  role user_role [not null]
  organizational_unit_id bigint
  is_active boolean [not null, default: true]
  email_verified_at datetime
  last_login_at datetime
  created_at datetime [not null]
  updated_at datetime [not null]

  Note: 'UNIT_ADMIN requires organizational_unit_id. USER and SUPER_ADMIN have no unit scope.'
}

// Fine-grained grants are separate from the account's base role.
Table user_permissions {
  id bigint [pk, increment]
  user_id bigint [not null]
  code varchar(80) [not null]
  created_at datetime [not null]
  updated_at datetime [not null]

  indexes {
    (user_id, code) [unique, name: 'uq_user_permissions_user_code']
  }
}

Table profiles {
  id bigint [pk, increment]
  user_id bigint [not null, unique]
  organizational_unit_id bigint [not null]
  slug varchar(180) [not null, unique]
  full_name varchar(200) [not null]
  photo_url varchar(2048)
  email varchar(320)
  orcid_url varchar(2048)
  linkedin_url varchar(2048)
  github_url varchar(2048)
  google_scholar_url varchar(2048)
  main_function main_function [not null]
  category profile_category [not null]
  position profile_position
  area_of_activity text
  publication_status publication_status [not null, default: 'DRAFT']
  created_at datetime [not null]
  updated_at datetime [not null]

  Note: 'category must be valid for main_function. Only PUBLISHED profiles of active accounts are public.'
}

Table courses {
  id bigint [pk, increment]
  organizational_unit_id bigint [not null]
  name varchar(200) [not null]
  code varchar(40) [not null]
  description text
  degree_level degree_level [not null]
  is_active boolean [not null, default: true]
  created_at datetime [not null]
  updated_at datetime [not null]

  indexes {
    (organizational_unit_id, code) [unique]
  }
}

Table disciplines {
  id bigint [pk, increment]
  course_id bigint [not null]
  name varchar(200) [not null]
  code varchar(40) [not null]
  description text
  curricular_year tinyint [not null, note: '1st, 2nd, 3rd year, etc.']
  is_active boolean [not null, default: true]
  created_at datetime [not null]
  updated_at datetime [not null]

  indexes {
    (course_id, code) [unique]
  }
}

Table academic_years {
  id bigint [pk, increment]
  organizational_unit_id bigint [not null]
  label char(9) [not null, note: 'Consecutive years in YYYY/YYYY format, e.g. 2022/2023.']
  status academic_year_status [not null]
  opened_at datetime
  opened_by_user_id bigint
  closed_at datetime
  closed_by_user_id bigint
  open_unit_guard bigint [null, unique, note: 'Generated helper: unit id while OPEN, NULL while CLOSED; enforces one open year per unit.']
  created_at datetime [not null]
  updated_at datetime [not null]

  indexes {
    (organizational_unit_id, label) [unique]
  }

  checks {
    `label REGEXP '^[0-9]{4}/[0-9]{4}$' AND CAST(SUBSTRING(label, 6, 4) AS UNSIGNED) = CAST(SUBSTRING(label, 1, 4) AS UNSIGNED) + 1` [name: 'chk_academic_year_consecutive_label']
    `(status = 'OPEN' AND closed_at IS NULL AND closed_by_user_id IS NULL) OR status = 'CLOSED'` [name: 'chk_academic_year_closure']
  }

  Note: 'UNIT_ADMIN manages years for its own unit; SUPER_ADMIN may manage all units. CLOSED years cannot be edited or reopened. Imported years with unknown closure metadata can be activated once.'
}

Table teaching_assignments {
  id bigint [pk, increment]
  profile_id bigint [not null]
  discipline_id bigint [not null]
  academic_year_id bigint [not null]
  created_at datetime [not null]
  updated_at datetime [not null]

  indexes {
    (discipline_id, academic_year_id) [unique, note: 'A discipline can have only one teacher in an academic year.']
    (profile_id, academic_year_id)
  }

  Note: 'The academic year must belong to the discipline course unit. The profile may belong to another unit.'
}

Table teaching_assignment_semesters {
  id bigint [pk, increment]
  teaching_assignment_id bigint [not null]
  semester tinyint [not null, note: '1 or 2']
  created_at datetime [not null]
  updated_at datetime [not null]

  indexes {
    (teaching_assignment_id, semester) [unique]
  }

  checks {
    `semester IN (1, 2)` [name: 'chk_teaching_assignment_semester']
  }
}

Table academic_education {
  id bigint [pk, increment]
  profile_id bigint [not null]
  title_obtained varchar(120) [not null]
  course varchar(200) [not null]
  institution varchar(200) [not null]
  country varchar(100)
  completion_year smallint
  created_at datetime [not null]
  updated_at datetime [not null]
}

Table research_lines {
  id bigint [pk, increment]
  profile_id bigint [not null]
  title varchar(200) [not null]
  description text
  created_at datetime [not null]
  updated_at datetime [not null]
}

Table publications {
  id bigint [pk, increment]
  profile_id bigint [not null]
  title varchar(500) [not null]
  description text
  link varchar(2048)
  type publication_type [not null]
  citation text
  publication_year smallint
  created_at datetime [not null]
  updated_at datetime [not null]
}

Ref: users.organizational_unit_id > organizational_units.id [delete: restrict, update: restrict]
Ref: user_permissions.user_id > users.id [delete: cascade, update: restrict]
Ref: profiles.user_id - users.id [delete: restrict, update: restrict]
Ref: profiles.organizational_unit_id > organizational_units.id [delete: restrict, update: restrict]
Ref: courses.organizational_unit_id > organizational_units.id [delete: restrict, update: restrict]
Ref: disciplines.course_id > courses.id [delete: restrict, update: restrict]
Ref: academic_years.organizational_unit_id > organizational_units.id [delete: restrict, update: restrict]
Ref: academic_years.opened_by_user_id > users.id [delete: restrict, update: restrict]
Ref: academic_years.closed_by_user_id > users.id [delete: restrict, update: restrict]
Ref: teaching_assignments.profile_id > profiles.id [delete: restrict, update: restrict]
Ref: teaching_assignments.discipline_id > disciplines.id [delete: restrict, update: restrict]
Ref: teaching_assignments.academic_year_id > academic_years.id [delete: restrict, update: restrict]
Ref: teaching_assignment_semesters.teaching_assignment_id > teaching_assignments.id [delete: restrict, update: restrict]
Ref: academic_education.profile_id > profiles.id [delete: restrict, update: restrict]
Ref: research_lines.profile_id > profiles.id [delete: restrict, update: restrict]
Ref: publications.profile_id > profiles.id [delete: restrict, update: restrict]
